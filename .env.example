# invisible-string — environment variables (copy to .env; never commit .env)

# ── Postgres ────────────────────────────────────────────────────────────────
# Product data (control plane + Better Auth). Compose creates the "product" DB.
DATABASE_URL=postgres://dev:dev@localhost:5432/product
# eve durability world (@workflow/world-postgres). Compose creates the "world" DB.
WORLD_DATABASE_URL=postgres://dev:dev@localhost:5432/world

# ── Secrets ─────────────────────────────────────────────────────────────────
# Master key for AES-256-GCM envelope encryption of secrets at rest
# (MCP auth configs, integration credentials, trigger secrets).
# Generate: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=
# HMAC secret for platform-signed JWTs (dispatcher -> compiled channel,
# control plane <-> worker /internal/* auth).
# Generate: openssl rand -base64 32
PLATFORM_JWT_SECRET=

# ── Object storage (S3-compatible; Garage in dev) ───────────────────────────
# Build-artifact tarballs + trigger file payloads live in the "artifacts"
# bucket (auto-created by the garage service's GARAGE_DEFAULT_* env).
S3_ENDPOINT=http://localhost:3900
S3_ACCESS_KEY_ID=GKdeadbeefdeadbeefdeadbeefdeadbeef
S3_SECRET_ACCESS_KEY=cafebabecafebabecafebabecafebabecafebabecafebabecafebabecafebabe
S3_BUCKET=artifacts
S3_REGION=us-east-1

# ── Registry search (Meilisearch) ───────────────────────────────────────────
# Disposable search mirror of the official MCP registry (compose service
# `meilisearch`; the dev master key is a hardcoded localhost throwaway, same
# stance as the S3 keys above). Unset BOTH to run without it — registry
# search degrades, nothing else; the control plane never requires Meilisearch
# to boot. No backups ever: an empty index is rebuilt by a full resync.
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=dev-meili-master-key
# Registry→Meilisearch sync cadence (ms): how often the control plane mirrors
# the official MCP registry into the index (immediate run at boot, then this
# interval; multi-instance safe via an advisory lock). Default 6 h.
# REGISTRY_SYNC_INTERVAL_MS=21600000
# Override the official MCP registry base URL — DEV/CI ONLY (test harnesses
# point the proxy client + sync ETL at a local stub). Never set in production:
# the SSRF containment assumes the single hardcoded host.
# MCP_REGISTRY_BASE_URL=
# Let the guarded egress helper (MCP probe + the OAuth broker's discovery/
# DCR/token calls) reach private/loopback addresses AND plain-http targets —
# DEV/E2E/SELF-HOSTED ONLY (stubs live on http://127.0.0.1). Never set in
# production: it relaxes both the private-range rejection and HTTPS-only.
# MCP_PROBE_ALLOW_PRIVATE=1

# ── Model providers (platform-owned; exactly one injected per compiled agent) ─
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# ── Better Auth ─────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Require verified email before sign-in (1 to enable). Default off: local/CI
# stacks have no mailer. Enable in production before trust decisions.
# AUTH_REQUIRE_EMAIL_VERIFICATION=1

# ── OAuth token broker (compiled agents → control plane) ────────────────────
# Control-plane base URL AS REACHABLE FROM THE WORKER NETWORK — compiled
# agents with OAuth connections call POST /internal/connections/token on it
# (self-minted version-bound platform JWT; access tokens never enter agent
# env). Prod compose sets http://control-plane:3000. Optional: absent, oauth
# connections' tool calls fail with a missing-env error; nothing else breaks.
PLATFORM_API_URL=http://localhost:3000

# ── MCP OAuth consent: popup result delivery ────────────────────────────────
# THE SPA ORIGIN the consent popup postMessages its result to (targetOrigin).
# This is NOT the OAuth redirect_uri: the callback is served by the CONTROL
# PLANE at PUBLIC_APP_URL/integrations/mcp-oauth/callback (below), but the
# window that OPENED the popup is the SPA. In production behind the nginx
# gateway the two are one origin and this var is unnecessary — it defaults to
# PUBLIC_APP_URL. In local dev they differ (API :3000, Vite :5173), and a
# postMessage whose targetOrigin does not match the receiving window is
# dropped by the browser with NO error, NO exception and NO devtools warning:
# the SPA then falls back to popup-close polling and reports a dismissal for a
# consent that actually succeeded. Hence the active dev value below — leave it
# UNSET in a single-origin production deployment so it tracks PUBLIC_APP_URL.
# Must be an absolute http(s) origin (path/query are trimmed to the origin);
# a malformed value fails boot rather than failing silently at consent time.
PUBLIC_WEB_URL=http://localhost:5173

# ── MCP OAuth consent: pre-registered clients (optional) ────────────────────
# The broker normally mints its own OAuth client per connection — CIMD where
# the authorization server supports it, else RFC 7591 dynamic registration.
# Some authorization servers gate registration behind an approved-client
# allowlist and reject every DCR request, which surfaces as a 502 right after
# the consent popup opens. Those providers need credentials the AS issued you
# out of band: their catalog entry declares `clientIdentity: "preregistered"`
# and authors the <PREFIX> that names them (packages/shared's
# `preregisteredClientEnvVars` renders the same two spellings for the UI).
#   MCP_OAUTH_<PREFIX>_CLIENT_ID       required — the AS-issued client_id
#   MCP_OAUTH_<PREFIX>_CLIENT_SECRET   optional — omit for a public client
#   MCP_OAUTH_<PREFIX>_ISSUER          REQUIRED — the authorization-server
#                                      issuer these credentials belong to.
#                                      Not a nicety: without it the client
#                                      matches whatever issuer discovery
#                                      reports, so a repointed MCP server
#                                      could nominate its own AS and be handed
#                                      your approved client_id and secret.
#                                      A client id configured without it is a
#                                      BOOT FAILURE, not a silent fallback.
# <PREFIX> is UPPER_SNAKE, one per provider. A half-configured provider (a
# secret or issuer with no client id) or an unrecognised MCP_OAUTH_* suffix
# fails boot rather than being silently ignored. The secret is a real
# credential: keep it out of git and out of logs. NOTE for prod compose: the
# control-plane service enumerates its environment explicitly, so the first
# preset that needs one of these must also add the variable to
# docker-compose.prod*.yml (and to docs/DEPLOY.md §3) — setting it in the
# deploy env alone will not reach the container.
# No shipped preset needs these today. The shape, using the provider that
# forced them (Vercel — removed from the catalog until approved credentials
# exist, and note its AS also speaks only the web_message response mode):
# MCP_OAUTH_VERCEL_CLIENT_ID=
# MCP_OAUTH_VERCEL_CLIENT_SECRET=
# MCP_OAUTH_VERCEL_ISSUER=https://vercel.com

# ── Web app (Vite; only VITE_-prefixed vars reach the browser bundle) ───────
# Control-plane origin the SPA calls for API + Better Auth. Set to the
# control-plane origin, or to an EMPTY string for same-origin production
# builds (the prod web image bakes VITE_API_URL=). Defaults to
# http://localhost:3000 when unset.
VITE_API_URL=http://localhost:3000
# Set to 1 to render the chat surface from canned fixtures with no backend
# (design/E2E preview; bypasses the auth gate). Leave unset in normal dev.
# VITE_FIXTURE_MODE=1

# ── Observability (optional) ─────────────────────────────────────────────────
# Floor log level for the structured JSON logger (debug|info|warn|error).
# Defaults to info. GET /internal/metrics (worker-secret-guarded) and
# GET /api/health?deep=1 need no extra config.
# LOG_LEVEL=info

# ── Run execution caps + per-agent budgets (control plane; optional) ─────────
# Per-run wall-clock cap before the run is failed (ms, default 10 min).
# MAX_RUN_WALL_CLOCK_MS=600000
# Concurrent-run cap per workspace (default 5).
# MAX_CONCURRENT_RUNS_PER_WORKSPACE=5
# SSE heartbeat comment interval on run tails (ms, default 15 s; tests shrink
# it — pairs with the disabled Bun idleTimeout, see AGENTS.md constraints).
# SSE_HEARTBEAT_MS=15000
# Per-agent world-Postgres connection budget forwarded into agent env
# (graphile defaults multiply badly at ~20 agents/worker; both default 5).
# WORKFLOW_POSTGRES_MAX_POOL_SIZE=5
# WORKFLOW_POSTGRES_WORKER_CONCURRENCY=5

# ── Worker pool + per-worker identity (Phase 3) ──────────────────────────────
# Shared secret the worker plane presents on /internal/* (register/heartbeat/
# dispatch). Generate: openssl rand -base64 32
WORKER_SHARED_SECRET=
# shared-secret (default) keeps the single-credential Phase-1 behaviour;
# worker-token mints a per-worker HS256 session token at register (rotated on
# heartbeat) + a per-call dispatch token (audience worker:<id>) on ensure-agent.
# WORKER_AUTH_MODE=shared-secret
# Heartbeat freshness window before the sweeper marks a worker dead (ms).
# WORKER_HEARTBEAT_TTL_MS=30000
# Dead-worker sweep interval; defaults to the heartbeat TTL.
# WORKER_SWEEP_INTERVAL_MS=30000
# Per-worker agent-slot cap the scheduler enforces when a worker omits maxAgents.
# SCHEDULER_MAX_AGENTS_PER_WORKER=20
# Timeout for non-streaming control-plane→worker calls (ms, default 120 s):
# ensure-agent is synchronous and a COLD first boot (download + extract +
# node boot + world migration) can exceed 60 s.
# WORKER_REQUEST_TIMEOUT_MS=120000
# Registration allowlist: only these worker ids may register (comma-separated
# UUIDs). Unset = any id presenting the shared secret may register (dev only).
# WORKER_ALLOWED_IDS=
# Worker registration/dispatch normally requires https:// addresses
# (secret-bearing calls). Required for local dev, where workers register over
# http://localhost — `bun run dev`'s bootstrap enables it automatically in
# generated .env files; uncomment only if you hand-built your .env. Never
# enable across a routable network. The prod compose enables it for its
# private inter-container bridge, compensated by worker-token auth + a pinned
# worker-id allowlist (docs/DEPLOY.md).
# ALLOW_INSECURE_WORKER_TRANSPORT=1

# ── Agent build pipeline (control plane) ────────────────────────────────────
# Canonical directory `eve build` compiles agent projects under
# (<AGENT_BUILD_ROOT>/<hash>). Compiled artifacts bake in absolute paths, so
# this MUST be identical to the worker's ARTIFACT_CACHE_DIR (below) — a
# worker extracts into the exact path a build wrote to. Default
# /var/lib/agents (matches the worker's own default; the compose stack
# mounts it). `bun run dev` bootstrap sets this, paired with
# ARTIFACT_CACHE_DIR, to <repo>/.dev/agent-cache.
# AGENT_BUILD_ROOT=/var/lib/agents
# Shared npm cache dir for agent-project `npm install` during build.
# Defaults to <os tmpdir>/invisible-string-npm-cache when unset.
# NPM_CACHE_DIR=

# Node binary for build subprocesses (npm install / `eve build` / world setup
# — eve needs Node 24). Unset: newest mise-installed node 24.x, then `node`
# on PATH (the prod image bakes Node 24 there; the mise BINARY is never
# required at runtime). Mirrors WORKER_NODE_BIN below.
# BUILD_NODE_BIN=node

# ── Worker app (apps/worker) ─────────────────────────────────────────────────
# Control-plane base URL for register/heartbeat/deregister. Required — no
# default (mirrors the control plane's own :3000 from BETTER_AUTH_URL above).
CONTROL_PLANE_URL=http://localhost:3000
# Stable worker identity; random UUID per boot when unset.
# WORKER_ID=
# Base URL this worker advertises to the control plane (default http://localhost:<PORT>).
# PUBLIC_URL=
# Extracted-artifact cache root. Default /var/lib/agents suits the Linux
# worker image but is not writable on macOS — `bun run dev` bootstrap points
# fresh .env files at <repo>/.dev/agent-cache (gitignored) instead.
# ARTIFACT_CACHE_DIR=/var/lib/agents
# LRU cap for extracted artifacts (bytes, default 20 GiB).
# ARTIFACT_CACHE_MAX_BYTES=21474836480
# Stop agent processes idle this long (ms, default 15 min).
# AGENT_IDLE_STOP_MS=900000
# Max wait for /eve/v1/health after agent spawn (ms, default 60 s).
# AGENT_READY_TIMEOUT_MS=60000
# Node runtime used to launch compiled agents (eve needs Node 24).
# WORKER_NODE_BIN=node

# ── Sandbox reaper (worker-side; needs a docker daemon) ──────────────────────
# Stops eve-session sandboxes idle past the window (design correction 4). Off by
# default; eve gives sandboxes no idle timeout of its own.
# SANDBOX_REAPER_ENABLED=1
# SANDBOX_IDLE_STOP_MS=1800000
# SANDBOX_LABEL=eve.session
# DOCKER_BIN=docker

# ── Triggers + Slack app (Phase 3) ───────────────────────────────────────────
# Webhook/form ingress works with no extra config (POST /t/:token). The Slack
# app is optional — only needed to install the platform Slack integration.
# Create it from the checked-in manifest (`bun run slack:manifest`), then copy
# its Basic Information credentials here — all three or none. Setup guide:
# docs/SLACK.md.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# OAuth bot scopes (comma/space-separated; has a sensible default).
# SLACK_BOT_SCOPES=
# Public origin the app is reached at — the Slack OAuth redirect, webhook
# ingress URLs, and the MCP OAuth broker's consent callback + client-metadata
# (CIMD) URLs all derive from it. Falls back to BETTER_AUTH_URL, then
# localhost:3000. This is the CONTROL-PLANE origin; where the SPA is served
# from a different one (local dev), the consent popup's postMessage target is
# PUBLIC_WEB_URL instead — see the MCP OAuth consent section above.
# PUBLIC_APP_URL=http://localhost:3000
# Override the Slack Web API / consent bases (tests point these at a stub server).
# SLACK_API_BASE_URL=https://slack.com/api
# SLACK_AUTHORIZE_URL=https://slack.com/oauth/v2/authorize
# Ingress rate limits (fixed window per minute).
# TRIGGER_RATE_LIMIT_PER_TOKEN_PER_MIN=60
# TRIGGER_RATE_LIMIT_PER_IP_PER_MIN=120
# Schedule-ticker cadence (ms): how often the control plane scans for due
# cron triggers (schedule-type workflows). Multi-instance safe (per-trigger
# advisory locks); tests shrink it. Default 30s.
# SCHEDULE_TICK_MS=30000

# ── Builder copilot (Phase 4) ────────────────────────────────────────────────
# The copilot socket (WS /workspaces/:id/copilot) mounts only when a provider
# key exists: OPENROUTER_API_KEY for the default openrouter provider (Claude
# via OpenRouter on the platform key), ANTHROPIC_API_KEY for the direct path.
# COPILOT_PROVIDER=openrouter            # openrouter (default) | anthropic
# COPILOT_MODEL=anthropic/claude-sonnet-5
# COPILOT_MAX_SESSIONS=2                 # concurrent sessions per workspace
# COPILOT_MAX_OUTPUT_TOKENS=8192         # per-turn model output budget
# COPILOT_MAX_STEPS=12                   # per-turn tool-loop round-trip cap
# Reasoning effort for the copilot's OWN turns. One of the shared 8:
# provider-default | none | minimal | low | medium | high | xhigh | max.
# Defaults to provider-default = NO reasoning block on the wire (the historical
# behaviour), because reasoning tokens bill to the platform key on every turn.
# An unrecognised value falls back to the default rather than failing boot.
# COPILOT_REASONING_EFFORT=provider-default
# Deterministic scripted fake LLM (tests only; JSON script) — when set the
# socket mounts without any provider key and never calls a real model.
# COPILOT_FAKE_SCRIPT=
# Real-model copilot smoke test gate (with OPENROUTER_API_KEY):
# COPILOT_KEYED=1

# ── Chat session titles ─────────────────────────────────────────────────────
# After a chat thread's first message the control plane generates a short
# title for the sidebar, fire-and-forget on the platform key against the
# workspace's `quick` model preset. It costs a handful of tokens per new
# thread and NEVER blocks or fails a message send: no key, no preset, a
# timeout or a junk completion all leave the title NULL and the sidebar falls
# back to truncating the first message.
# The titling model AND its reasoning effort both come from that preset row
# (`quick` seeds to the same model id as `balanced` and differs only by its
# `low` effort) — there is no env var for either.
# Kill switch for operators who have a platform key but not the spend. Read
# from the SAME environment the control plane was constructed with, so an
# in-process harness that injects a provider key can disable titling in the
# same record and be obeyed.
# Unset means ON in a normal deployment and OFF under `bun test` (an
# in-process test stack must not make an unmocked provider call); =1 forces
# it on everywhere, =0 off everywhere.
# SESSION_TITLE_ENABLED=1
# Wall-clock cap on the one titling round-trip (ms, default 15s).
# SESSION_TITLE_TIMEOUT_MS=15000

# ── docker-compose host-port overrides (optional) ───────────────────────────
POSTGRES_PORT=5432
GARAGE_PORT=3900
DEX_PORT=5556
# Keep MEILISEARCH_URL above in sync when overriding this.
MEILISEARCH_PORT=7700

# ── Tests ───────────────────────────────────────────────────────────────────
# DB-dependent tests run only when set (integration stage provides it);
# they skip cleanly otherwise.
TEST_DATABASE_URL=

# ── Marketing/docs site (apps/site) ─────────────────────────────────────────
# VITE_SITE_URL is an apps/site build-time variable set by
# .github/workflows/site.yml (fixed to https://invisiblestring.io); it is the
# origin baked into every canonical, OG tag, sitemap entry and robots.txt of
# the prerendered build, and defaults to http://localhost:5173. SITE_INDEXABLE
# is a build-time variable set to "1" by that workflow's DEPLOY job ONLY —
# fail-safe: any other value, including unset, emits noindex,nofollow on every
# page and `Disallow: /` in robots.txt, so preview versions and local builds
# can never compete with production in search. SITE_BASE is local-only and
# defaults to / — the deployed site always serves at the domain root.
# VITE_APP_URL is optional (unset by default) and surfaces the "Open the app"
# nav CTA when provided at build time. None are ever needed in .env. See
# apps/site/README.md.
